{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "A restaurant organization profile created by Super Admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "adminEmail": { "type": "string" },
        "adminPassword": { "type": "string" },
        "logo": { "type": "string" },
        "banner": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "slug", "adminEmail", "status"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Restaurant settings controlling branding, hours, contact, and active state.",
      "type": "object",
      "properties": {
        "restaurantName": { "type": "string" },
        "restaurantLogo": { "type": "string" },
        "restaurantBanner": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "darkModeLogo": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "instagram": { "type": "string" },
        "openingTime": { "type": "string" },
        "closingTime": { "type": "string" },
        "isOpen": { "type": "boolean" },
        "footerText": { "type": "string" },
        "copyright": { "type": "string" }
      },
      "required": ["restaurantName", "isOpen"]
    },
    "Category": {
      "title": "Category",
      "description": "A food category such as Starters, Mains, Desserts, Drinks.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "sortOrder"]
    },
    "Product": {
      "title": "Product",
      "description": "A menu item containing detailed pricing, badges, and availability.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "isVeg": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "isPopular": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["categoryId", "name", "price", "isAvailable", "isVeg"]
    },
    "Table": {
      "title": "Table",
      "description": "A physical dining table mapped to a valid table identifier.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "An order document placed by a customer from a specific table.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "tableNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "preparing", "ready", "completed", "cancelled"] },
        "customerNotes": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string" },
        "items": { "type": "array" }
      },
      "required": ["tableNumber", "status", "totalAmount"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Individual ordered item linking back to a main order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "orderId": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" }
      },
      "required": ["orderId", "productId", "name", "quantity", "price"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Restaurant profile documents."
    },
    "/restaurants/{restaurantId}/settings/{settingId}": {
      "schema": "Setting",
      "description": "Settings for a specific restaurant."
    },
    "/restaurants/{restaurantId}/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories for a specific restaurant."
    },
    "/restaurants/{restaurantId}/products/{productId}": {
      "schema": "Product",
      "description": "Menu products for a specific restaurant."
    },
    "/restaurants/{restaurantId}/tables/{tableId}": {
      "schema": "Table",
      "description": "Tables for a specific restaurant."
    },
    "/restaurants/{restaurantId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders for a specific restaurant."
    },
    "/restaurants/{restaurantId}/orderItems/{orderItemId}": {
      "schema": "OrderItem",
      "description": "Order items for a specific restaurant."
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Root settings configuration fallback."
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Root product categories fallback."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Root menu products fallback."
    },
    "/tables/{tableId}": {
      "schema": "Table",
      "description": "Root tables list fallback."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Root customer orders fallback."
    },
    "/orderItems/{orderItemId}": {
      "schema": "OrderItem",
      "description": "Root order items fallback."
    }
  }
}
