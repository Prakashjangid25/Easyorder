rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Top-Level Restaurants Collection
    match /restaurants/{restaurantId} {
      // Restaurants are readable by anyone (so customer QR view can verify restaurant exists/is active)
      allow read: if true;
      // Writeable by authenticated admin/superadmin
      allow write: if isSignedIn();

      // Nested Restaurant Settings
      match /settings/{settingId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Nested Categories
      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Nested Products
      match /products/{productId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Nested Tables
      match /tables/{tableId} {
        allow read: if true;
        allow write: if isSignedIn();
      }

      // Nested Orders
      match /orders/{orderId} {
        allow create: if true;
        allow get: if true;
        allow list, update, delete: if isSignedIn();
      }

      // Nested OrderItems
      match /orderItems/{orderItemId} {
        allow create: if true;
        allow get: if true;
        allow list, update, delete: if isSignedIn();
      }
    }

    // ROOT LEVEL FALLBACKS FOR SINGLE-TENANT BACKWARD COMPATIBILITY

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /tables/{tableId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isSignedIn();
    }

    match /orderItems/{orderItemId} {
      allow create: if true;
      allow get: if true;
      allow list, update, delete: if isSignedIn();
    }
  }
}
